{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "OpsPilot",
  "version": "0.1.5",
  "identifier": "com.opspilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8791",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:shell"
  },
  "app": {
    "windows": [
      {
        "title": "OpsPilot",
        "label": "main",
        "url": "http://127.0.0.1:8791",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
